# Copy this file to `.env` and fill in real values locally.
# `.env` is git-ignored and must never be committed.

# --- backend ---
# Local development uses SQLite. The deployed backend uses the PostgreSQL
# connection string of the Neon instance (copied from the Neon console).
DATABASE_URL=sqlite:///./data/app.db
# Token required by every /admin endpoint. Use a long random string in the cloud.
ADMIN_TOKEN=local-dev-admin-token
TIMEZONE=Europe/Budapest
OPEN_HOUR=8
CLOSE_HOUR=20
LOG_LEVEL=INFO

# --- maintenance controller (local only) ---
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_ORG_ID=
NEON_PROJECT_NAME=room-booking-prod
NEON_REGION_ID=aws-eu-central-1
NEON_PG_VERSION=17
RENDER_API_KEY=
RENDER_SERVICE_ID=
BACKEND_BASE_URL=http://127.0.0.1:8000
MAINTENANCE_INTERVAL_MINUTES=60
MAINTENANCE_EXPIRY_WARNING_HOURS=72

# --- frontend ---
API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=10
